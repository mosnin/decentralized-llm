FROM python:3.11-slim

WORKDIR /app
COPY pyproject.toml ./
COPY client/ ./client/
COPY integrations/ ./integrations/

RUN pip install --no-cache-dir fastapi uvicorn anchorpy solders solana

COPY scripts/api_gateway.py ./api_gateway.py

EXPOSE 8000

CMD ["uvicorn", "api_gateway:app", "--host", "0.0.0.0", "--port", "8000"]
