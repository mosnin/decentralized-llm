# ── Solana ──────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
WALLET_PATH=~/.config/solana/id.json

# Programs (replace with deployed addresses after `anchor deploy`)
COMPUTE_REGISTRY_PROGRAM=8KpR2mT6uLqVwNzS4eBfY9oA3cJ7iGxH1nD5sW0qF2M
INFERENCE_MARKET_PROGRAM=5YQyZqXkJHy6V3JMxKqXyLqfP9V2A3j8Rk7mN4oD1eW
GOVERNANCE_PROGRAM=3CvE7tX9rMwPfBgY2nKjH6oL4sQ8uZaD5mR1iW0eN9T

# ── Model node ──────────────────────────────────────────────────────────────
MODEL_NAME=meta-llama/Llama-3.2-3B
NUM_SHARDS=4
SHARD_INDEX=0

# Public IP/hostname as seen from other nodes (critical for rented GPU instances)
# On Vast.ai/RunPod: set to the public IP shown in the instance dashboard
PUBLIC_HOST=

LISTEN_HOST=0.0.0.0
LISTEN_PORT=7070

# Comma-separated list of known bootstrap peers
DHT_BOOTSTRAP_PEERS=

MODEL_DTYPE=float16          # float16 | bfloat16 | int8 | int4
MODEL_CACHE_DIR=~/.cache/decentralized-llm
MAX_CONCURRENT_JOBS=4
JOB_POLL_INTERVAL=2.0

# Enable federated fine-tuning contribution
FINETUNING_ENABLED=false
LORA_RANK=8

# ── Pay.sh ──────────────────────────────────────────────────────────────────
PAYSH_API_KEY=
PAYSH_WEBHOOK_SECRET=
